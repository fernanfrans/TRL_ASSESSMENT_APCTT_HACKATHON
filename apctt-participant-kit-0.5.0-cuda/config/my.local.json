{
  "config_version": "apctt-config-v1",
  "profile": "dev",
  "bind_host": "127.0.0.1",
  "bind_port": 8000,
  "data_dir": "../server_data",
  "worker_tmp_dir": "../worker_tmp",
  "schema_version": "apctt-pdf-example-v1",
  "checklist_path": "../contracts/checklist.official.json",
  "retry_after_seconds": 1,
  "limits": {
    "max_request_bytes": 83886080,
    "max_documents": 3,
    "max_document_bytes": 52428800,
    "max_total_pages": 300,
    "max_result_bytes": 2097152,
    "deadline_ms": 180000,
    "termination_grace_ms": 2000,
    "max_log_bytes": 1048576,
    "max_observation_bytes": 32768,
    "max_jobs": 1000,
    "min_free_disk_bytes": 104857600,
    "max_diagnostics_bytes": 32768,
    "max_field_errors": 20,
    "max_stack_frames": 10
  },
  "compute": {
    "device": "cpu",
    "require_cuda": false,
    "allow_cpu_fallback": false,
    "precision": "float32",
    "loading_policy": "cold_per_case",
    "seed": 42
  },
  "module": {
    "package_id": "my-team-module",
    "entrypoint": "participant_module.adapter:AssessmentModule",
    "module_root": "../../my_submission",
    "package_root": "../../my_submission/participant_module",
    "asset_root": "../../my_submission/assets",
    "declared_package_sha256": null,
    "example_only": false,
    "settings": {}
  },
  "worker": {
    "python": "../../apctt-env/base/bin/python",
    "launcher_argv": [],
    "extra_env": {
      "APCTT_MODEL_STORE": "/mnt/f/TRL_APCTT/models"
    }
  },
  "isolation": {
    "evidence_file": null
  },
  "auth": {
    "bearer_token_file": null
  }
}